
<!DOCTYPE html>
<html>
<head>
<title>Advanced CSS</title>

<style>
    .box {
        background-color: lightblue;
        width: 250px;
        padding: 30px;
        margin: 30px;

        /* Rounded corners */
        border-radius: 20px;

        /* Shadow effect */
        box-shadow: 5px 5px 10px gray;

        /* Border image */
        border: 15px solid transparent;
        border-image: url("border.png") 30 round;
    }

    .circle {
        width: 120px;
        height: 120px;
        background: orange;
        border-radius: 50%;
    }
</style>
</head>

<body>

    <h2>Advanced CSS Features</h2>

    <div class="box">
        Rounded Corner and Border Image
    </div>

    <div class="circle"></div>

</body>
</html>
