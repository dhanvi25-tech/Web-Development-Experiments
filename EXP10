let a = 20;
let b = 10;

// Arithmetic operators
document.write("Addition: " + (a + b) + "<br>");
document.write("Subtraction: " + (a - b) + "<br>");
document.write("Multiplication: " + (a * b) + "<br>");
document.write("Division: " + (a / b) + "<br>");
document.write("Modulus: " + (a % b) + "<br>");

// Comparison operators
document.write(a > b);
document.write("<br>" + (a == b));

// Logical operators
document.write("<br>" + (a > 5 && b < 20));
document.write("<br>" + (a > 30 || b < 20));

// Assignment operator
a += 5;
document.write("<br>New value of a: " + a);



