
<!DOCTYPE html>
<html>
<head>
<style>
    .left {
        float: left;
        width: 40%;
        background: lightblue;
        padding: 20px;
    }

    .right {
        float: right;
        width: 40%;
        background: lightgreen;
        padding: 20px;
    }

    .container::after {
        content: "";
        display: block;
        clear: both;
    }
</style>
</head>
<body>

<div class="container">
    <div class="left">Left Content</div>
    <div class="right">Right Content</div>
</div>

</body>
</html>
