
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Semantic Webpage</title>
</head>

<body>

    <!-- Header Section -->
    <header>
        <h1>My Website</h1>
        <p>Welcome to my website</p>
    </header>

    <!-- Navigation Section -->
    <nav>
        <ul>
            <li><a href="#home">Home</a></li>
            <li><a href="#about">About</a></li>
            <li><a href="#services">Services</a></li>
            <li><a href="#contact">Contact</a></li>
        </ul>
    </nav>

    <!-- Main Content -->
    <main>

        <!-- Home Section -->
        <section id="home">
            <h2>Home</h2>
            <p>Welcome to our website.</p>
        </section>

        <!-- About Section -->
        <section id="about">
            <h2>About Us</h2>
            <p>Learn more about our organization.</p>
        </section>

        <!-- Article Section -->
        <article>
            <h2>Latest News</h2>
            <p>This is an independent article.</p>
        </article>

        <!-- Sidebar Content -->
        <aside>
            <h3>Related Links</h3>
            <ul>
                <li><a href="#">Blog</a></li>
                <li><a href="#">Resources</a></li>
            </ul>
        </aside>

    </main>

    <!-- Footer Section -->
    <footer>
        <p>&copy; 2026 My Website. All rights reserved.</p>
    </footer>

</body>
</html>
